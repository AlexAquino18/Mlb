{
  "rewrites": [
    { "source": "/api/pp", "destination": "/api/pp" },
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/mlb", "destination": "/mlb/index.html" },
    { "source": "/mlb/", "destination": "/mlb/index.html" },
    { "source": "/nfl", "destination": "/nfl/index.html" },
    { "source": "/nfl/", "destination": "/nfl/index.html" },
    { "source": "/nba", "destination": "/nba/index.html" },
    { "source": "/nba/", "destination": "/nba/index.html" },
    { "source": "/cs2", "destination": "/cs2/index.html" },
    { "source": "/cs2/", "destination": "/cs2/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "functions": {
    "api/fangraphs_pitcher.py": { "maxDuration": 60 },
    "api/so_matchup.py": { "maxDuration": 60 },
    "api/batter_advanced.py": { "maxDuration": 60 },
    "api/odds_io.py": { "maxDuration": 60 },
    "api/nfl_stats.py": { "maxDuration": 30 },
    "api/cs2.py": { "maxDuration": 60, "includeFiles": "lib/cs2_scanner/**" },
    "api/pp.js": { "maxDuration": 30 },
    "api/billing.py": { "maxDuration": 30 }
  }
}
